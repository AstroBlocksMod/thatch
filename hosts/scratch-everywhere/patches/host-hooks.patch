+namespace {
+HostHooks::StartHatFn hostStartHat = nullptr;
+void *hostStartHatData = nullptr;
+} // namespace
+
+void HostHooks::setStartHat(StartHatFn fn, void *data) {
+    hostStartHat = fn;
+    hostStartHatData = data;
+}
+
+bool HostHooks::hasStartHat() {
+    return hostStartHat != nullptr;
+}
+
+bool HostHooks::startHat(Sprite *sprite, Block *hat, bool shouldRestart) {
+    if (hostStartHat == nullptr) return false;
+    hostStartHat(hostStartHatData, sprite, hat, shouldRestart);
+    return true;
+}
