--- /dev/null
+++ b/include/runtime/host_hooks.hpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include <se_export.hpp>
+
+class Sprite;
+struct Block;
+
+/**
+ * Lets a program that embeds the library run the project's scripts itself.
+ *
+ * Without a hook the library behaves as it always has. Once a host sets one, no script thread is
+ * started by the library any more: every hat block that would have started one (a key press, a
+ * click, a broadcast, the green flag) is handed to the host instead, which decides what to run.
+ * The library keeps doing everything else: loading the project, drawing, sound and input.
+ */
+namespace HostHooks {
+/**
+ * Called in place of starting a thread.
+ * @param data the pointer given to `setStartHat`
+ * @param sprite the sprite the hat belongs to
+ * @param hat the hat block
+ * @param shouldRestart whether a thread of this hat that is still running would have been restarted
+ */
+using StartHatFn = void (*)(void *data, Sprite *sprite, Block *hat, bool shouldRestart);
+
+/**
+ * Sets the hook, or removes it with `nullptr`.
+ */
+SE_EXPORT void setStartHat(StartHatFn fn, void *data);
+
+/**
+ * @return `true` if a host has set a hook, so hats go to it.
+ */
+SE_EXPORT bool hasStartHat();
+
+/**
+ * Hands a hat to the host.
+ * @return `false` if no host has set a hook, in which case nothing happened.
+ */
+SE_EXPORT bool startHat(Sprite *sprite, Block *hat, bool shouldRestart);
+} // namespace HostHooks
