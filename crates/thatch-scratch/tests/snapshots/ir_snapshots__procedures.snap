---
source: crates/thatch-scratch/tests/ir_snapshots.rs
expression: "thatch_ir::dump(&lowered.program)"
---
str 0 = "world"
str 1 = "B1"
str 2 = "B2"
str 3 = "LOUD"
str 4 = "hello "
target "Stage" (stage)
  backdrop 0 volume 100
  costumes ["backdrop1"]
  num 0 "total" = 0
target "Cat"
  at (0, 0) direction 90 size 100 costume 0 AllAround volume 100
  costumes ["costume1"]
  script FlagClicked -> fn 3
  script FlagClicked -> fn 4
fn 0 "Cat/countdown %s"(n: num)
  if Gt(Param(0), 0)
    Say((any)Param(0))
    call fn 0(Sub(ToNumber(Param(0)), 1)) nesting 1
fn 1 "Cat/sum to %s loudly %b"(n: num, loud: bool) warp
  set StageNum(0) = 0
  repeat ToNumber(Param(0))
    set StageNum(0) = Add(ToNumber(StageNum(0)), 1)
    yield
  if Param(1)
    Say((any)str 3)
fn 2 "Cat/greet %s %n"(who: any, times: num)
  repeat ToNumber(Param(1))
    Say((any)Join(str 4, (str)Param(0)))
    yield
fn 3 "Cat/flag flagA"()
  call fn 0(3) nesting 0
  call fn 1(100000, Not(false)) nesting 0
  Say((any)StageNum(0))
  call fn 2((any)str 0, 2) nesting 0
fn 4 "Cat/flag flagB"()
  Say((any)str 1)
  Say((any)str 2)
