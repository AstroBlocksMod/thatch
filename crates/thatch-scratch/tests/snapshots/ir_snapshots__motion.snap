  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  PointInDirection(-90)
  MoveSteps(20)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  PointTowards(str 3)
  Say((any)SpriteDirection())
  PointTowards(str 4)
  Say((any)SpriteDirection())
  GoTo(str 3)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  GoTo(str 4)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  Glide(0.5, 0, 0)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  Glide(0, 50, 60)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  GlideTo(0.3, str 3)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  GlideTo(0.3, str 4)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  SetX(0)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  SetRotationStyle(LeftRight)()
  Bounce()
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  Broadcast(str 7)
fn 1 "Dog/receive report"()
  Say((any)Join(str 9, (str)PropertyOf(str 10, str 11)))
  Say((any)Join(str 12, (str)PropertyOf(str 13, str 11)))
  Say((any)Join(str 14, (str)PropertyOf(str 15, str 11)))
