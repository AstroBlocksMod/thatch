str 41 = "Dog at "
target "Stage" (stage)
  backdrop 1 volume 100
  costumes ["backdrop1", "night"]
target "Cat"
  at (0, 0) direction 90 size 100 costume 0 AllAround volume 60
  costumes ["cat-a", "cat-b"]
  num 0 "score" = 42
  any 0 "word" = Str(StrId(8))
  script FlagClicked -> fn 0
target "Dog"
  at (100, 50) direction -45 size 150 costume 2 AllAround volume 100
  costumes ["dog-a", "dog-b", "dog-c"]
  script BroadcastReceived("report") -> fn 1
fn 0 "Cat/flag b1"()
  GoToXY(10, 20)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  ChangeX(5)
  ChangeY(-30)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  SetX(-7.5)
  SetY(3)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  MoveSteps(10)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  Say((any)SpriteDirection())
  Turn(90)
  Say((any)SpriteDirection())
  Turn(90)
  Say((any)SpriteDirection())
  Turn(Sub(0, 45))
  Say((any)SpriteDirection())
  PointInDirection(540)
  Say((any)SpriteDirection())
  PointInDirection(-180)
  Say((any)SpriteDirection())
  PointInDirection(181)
  Say((any)SpriteDirection())
  PointInDirection(0)
  Say((any)SpriteDirection())
  GoToXY(0, 0)
  MoveSteps(10)
  Say((any)Join((str)SpriteX(), Join(str 0, (str)SpriteY())))
  PointInDirection(180)
